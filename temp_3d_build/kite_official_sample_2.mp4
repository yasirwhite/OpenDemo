    <!--
      Notice the use of  in the tags above.
      It will be replaced with the URL of the `public` folder during the build.
      Only files inside the `public` folder can be referenced from the HTML.

      Unlike "/favicon.ico" or "favicon.ico", "/favicon.ico" will
      work correctly both with client-side routing and a non-root public URL.
      Learn how to configure a non-root public URL by running `npm run build`.
    -->
    <script src="/blur.js"></script>
    <!-- iubenda Privacy Controls and Cookie Solution -->
    <script type="text/javascript">
      // Google Consent Mode v2 defaults — must be set synchronously before
      // gtag.js loads; iubenda updates these on consent via googleConsentMode
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        // iubenda_cs loads on window load, so give early gtag hits time to
        // wait for the consent update instead of firing as denied
        wait_for_update: 8000,
      });

      var _iub = _iub || [];
      _iub.csConfiguration = {
        siteId: 3846428,
        cookiePolicyId: 24275151,
        cookiePolicyUrl: "https://kite.video/cookies",
        storage: { useSiteId: true },
        lang: "en",
        countryDetection: true,
        // We run no on-site programmatic ads, so the IAB TCF is unnecessary;
        // it also injects the "1188 third parties" disclosure into the banner.
        // Explicitly off here in case the dashboard-side setting re-enables it.
        enableTcf: false,
        perPurposeConsent: true,
        consentOnContinuedBrowsing: false,
        // NOTE: do not set googleConsentMode: "template" here — it disables
        // the autoblocking engine (see the init gate in
        // cs.iubenda.com/autoblocking/3846428.js). That engine pushes its own
        // Google Consent Mode update, but its purpose mapping is unreliable
        // (observed granting/denying the wrong flags), so the callback below
        // pushes an explicit update afterwards — last update wins per flag.
        callback: {
          // iubenda purposes: 3 = experience, 4 = measurement, 5 = advertising
          onPreferenceExpressedOrNotNeeded: function (preference) {
            var granted = function (g) {
              return g ? "granted" : "denied";
            };
            var purposes = preference && preference.purposes;
            var measurement, marketing;
            if (purposes) {
              // GDPR-style per-purpose consent
              measurement = preference.consent === true || !!purposes[4];
              marketing = preference.consent === true || !!purposes[5];
            } else {
              // Consent not required (or US opt-out framework): granted
              // unless the visitor opted out
              var optedOut = false;
              try {
                optedOut = window._iub.cs.api.isCcpaOptedOut();
              } catch (e) {}
              measurement = !optedOut;
              marketing = !optedOut;
            }
            gtag("consent", "update", {
              analytics_storage: granted(measurement),
              ad_storage: granted(marketing),
              ad_user_data: granted(marketing),
              ad_personalization: granted(marketing),
            });
          },
        },
        banner: {
          position: "float-bottom-center",
          acceptButtonDisplay: true,
          rejectButtonDisplay: true,
          customizeButtonDisplay: true,
          acceptButtonColor: "#FFFFFF",
          acceptButtonCaptionColor: "#000000",
          rejectButtonColor: "#1F1F1F",
          rejectButtonCaptionColor: "#FFFFFF",
          customizeButtonColor: "#1F1F1F",
          customizeButtonCaptionColor: "#FFFFFF",
          textColor: "white",
          backgroundColor: "#010101",
        },
      };
    </script>
    <script
      type="text/javascript"
      src="https://cs.iubenda.com/autoblocking/3846428.js"
    ></script>
    <script type="text/javascript" src="//cdn.iubenda.com/cs/gpp/stub.js"></script>
    <script type="text/javascript">
      // Load the banner UI only after the app has rendered, so it doesn't
      // flash on the empty page before React mounts. Tracker blocking is
      // unaffected: the autoblocking script above runs synchronously and
      // keeps trackers gated until consent is given.
      window.addEventListener("load", function () {
        var s = document.createElement("script");
        s.src = "https://cdn.iubenda.com/cs/iubenda_cs.js";
        s.charset = "UTF-8";
        s.async = true;
        document.head.appendChild(s);
      });
    </script>
    <style>
      /* Match iubenda banner buttons to the site's pill buttons (Inter 600,
         100px radius). Colors come from _iub.csConfiguration.banner; iubenda
         applies them inline, so only shape/typography live here. */
      /* iubenda injects its own stylesheet at runtime with !important rules
         up to (1,2,0) specificity — the body prefix + extra class keep these
         at (1,2,1) so they win regardless of injection order. */
      body #iubenda-cs-banner .iubenda-cs-opt-group .iubenda-cs-accept-btn,
      body #iubenda-cs-banner .iubenda-cs-opt-group .iubenda-cs-reject-btn,
      body #iubenda-cs-banner .iubenda-cs-opt-group .iubenda-cs-customize-btn {
        border-radius: 100px !important;
        font-family: "Inter", sans-serif !important;
        font-weight: 600 !important;
        font-size: 14px !important;
        padding: 10px 20px !important;
      }
    </style>
    <!-- End iubenda Privacy Controls and Cookie Solution -->
    <!-- Twitter conversion tracking base code -->
