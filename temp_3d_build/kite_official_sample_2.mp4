         consent isn't required) -->
    <script>
      !function(w){if(!w.rdt){var p=w.rdt=function(){p.sendEvent?p.sendEvent.apply(p,arguments):p.callQueue.push(arguments)};p.callQueue=[]}}(window);rdt('init','a2_j1ajqrb3b9if');rdt('track', 'PageVisit');
    </script>
    <script type="text/plain" class="_iub_cs_activate" data-iub-purposes="5">
      (function(d){var t=d.createElement("script");t.src="https://www.redditstatic.com/ads/pixel.js?pixel_id=a2_j1ajqrb3b9if";t.async=true;var s=d.getElementsByTagName("script")[0];s.parentNode.insertBefore(t,s);})(document);
    </script>
