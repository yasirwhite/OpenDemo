    <!-- Crisp loader is consent-gated via iubenda manual tagging. iubenda may
         activate this after the load event has fired, hence the readyState
         check -->
    <script type="text/plain" class="_iub_cs_activate" data-iub-purposes="3">
      (function () {
        function loadCrisp() {
          setTimeout(function () {
            if (window.DO_NOT_SHOW_CRISP_CHAT_AGAIN) {
              return;
            }

            var d = document;
            var s = d.createElement("script");
            s.src = "https://client.crisp.chat/l.js";
            s.async = 1;
            d.getElementsByTagName("head")[0].appendChild(s);
          }, 2000); // 2 second delay after page load
        }
        if (document.readyState === "complete") {
          loadCrisp();
        } else {
          window.addEventListener("load", loadCrisp);
        }
      })();
    </script>
