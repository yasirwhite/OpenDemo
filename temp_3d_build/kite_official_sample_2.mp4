    <script type="text/plain" class="_iub_cs_activate" data-iub-purposes="5">
      (function (t) {
        var u = t.createElement("script");
        u.async = true;
        // ads-twitter.com is also in the iubenda autoblocking blocklist, and
        // its US-framework check wrongly re-blocks it after activation.
        // data-cmp-ab="2" marks it as already consent-approved so the
        // autoblocker skips it — safe because this script only runs once
        // iubenda has activated it (consent given or not required). Must be
        // set BEFORE src: the autoblocker wraps the src setter.
        u.setAttribute("data-cmp-ab", "2");
        u.src = "https://static.ads-twitter.com/uwt.js";
        var a = t.getElementsByTagName("script")[0];
        a.parentNode.insertBefore(u, a);
      })(document);
    </script>
    <!-- End Twitter conversion tracking base code -->
    <!-- Reddit Pixel -->
    <!-- The stub queues events; the remote loader below is consent-gated via
