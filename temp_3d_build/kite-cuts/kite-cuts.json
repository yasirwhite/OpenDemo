{
  "$schema": "kite-cut-library/v1",
  "description": "Reusable cinematic 'cut' presets for 3D product-demo renders. Each cut = one shot: a device, an environment, a keyframed camera move, and a keyframed device pose. Play them back-to-back (hard cuts) to assemble a Kite-style montage. Angles in radians; camera as [px,py,pz, targetX,targetY,targetZ]; ease 'inOut' unless noted.",
  "devices": ["macbook", "iphone-portrait", "iphone-landscape", "panel"],
  "environments": {
    "dark":   "near-black studio, glossy dark floor + reflection",
    "orange": "warm macOS-Ventura orange gradient backdrop",
    "sky":    "light sky-blue gradient (airy)",
    "white":  "bright near-white studio, glossy floor + reflection"
  },
  "cuts": [
    {"name": "laptop-hero-3q-left",      "device": "macbook", "env": "dark",   "durationMs": 3500,
     "camera": {"from": [-4.8,3.1,12.6, 0,1.5,0], "to": [-3.2,2.7,11.2, 0,1.6,0]},
     "pose":   {"from": {"yaw": -0.42, "pitch": 0.06}, "to": {"yaw": -0.34, "pitch": 0.06}}},
    {"name": "laptop-push-in-screen",    "device": "macbook", "env": "dark",   "durationMs": 3300,
     "camera": {"from": [-1.8,2.4,8.4, 0,2.0,0], "to": [-0.5,2.8,5.4, 0,2.6,0]},
     "pose":   {"from": {"yaw": -0.30, "pitch": 0.03}, "to": {"yaw": -0.16, "pitch": 0.0}}},
    {"name": "laptop-orange-push",       "device": "macbook", "env": "orange", "durationMs": 3600,
     "camera": {"from": [-3.6,2.5,10.0, 0,1.5,0], "to": [-1.4,2.6,6.6, 0,2.1,0]},
     "pose":   {"from": {"yaw": -0.38, "pitch": 0.04}, "to": {"yaw": -0.22, "pitch": 0.02}}},
    {"name": "panel-orange-yaw-glide",   "device": "panel",   "env": "orange", "durationMs": 3000,
     "camera": {"from": [3.0,1.4,8.6, 0,2.4,0], "to": [1.2,2.0,7.4, 0,2.4,0]},
     "pose":   {"from": {"yaw": 0.5, "pitch": 0.06, "py": 2.6}, "to": {"yaw": 0.34, "pitch": 0.04, "py": 2.6}}},
    {"name": "laptop-wide-orbit",        "device": "macbook", "env": "dark",   "durationMs": 3400,
     "camera": {"from": [-5.5,3.2,12.5, 0,1.2,0], "to": [4.5,3.0,12.5, 0,1.2,0]},
     "pose":   {"from": {"yaw": -0.5, "pitch": 0.10}, "to": {"yaw": 0.4, "pitch": 0.10}}},
    {"name": "panel-white-3q-push",      "device": "panel",   "env": "white",  "durationMs": 3400,
     "camera": {"from": [3.4,1.2,9.2, 0,2.4,0], "to": [1.6,1.8,6.6, 0,2.4,0]},
     "pose":   {"from": {"yaw": 0.55, "pitch": 0.05, "py": 2.5}, "to": {"yaw": 0.40, "pitch": 0.03, "py": 2.5}}},
    {"name": "panel-sky-fullbleed",      "device": "panel",   "env": "sky",    "durationMs": 3000,
     "camera": {"from": [0.3,2.3,5.6, 0,2.4,0], "to": [-0.2,2.4,5.2, 0,2.4,0]},
     "pose":   {"from": {"yaw": 0.06, "pitch": 0.02, "py": 2.4}, "to": {"yaw": -0.04, "pitch": 0.02, "py": 2.4}}},
    {"name": "laptop-frontal-drift",     "device": "macbook", "env": "dark",   "durationMs": 3200,
     "camera": {"from": [-1.0,2.4,8.2, 0,1.9,0], "to": [0.6,2.4,7.8, 0,1.9,0]},
     "pose":   {"from": {"yaw": -0.12, "pitch": 0.03}, "to": {"yaw": 0.08, "pitch": 0.03}}},
    {"name": "phone-portrait-orbit",     "device": "iphone-portrait", "env": "white", "durationMs": 3400,
     "camera": {"from": [0.6,2.9,9.6, 0.2,2.7,0], "to": [-2.2,2.7,9.0, -0.2,2.7,0]},
     "pose":   {"from": {"yaw": 0.06, "pitch": 0.05, "py": 2.8}, "to": {"yaw": -0.62, "pitch": 0.10, "py": 2.8}}},
    {"name": "phone-landscape-diagonal", "device": "iphone-landscape", "env": "white", "durationMs": 3000,
     "camera": {"from": [-1.6,2.7,8.4, 0,2.5,0], "to": [1.9,2.7,8.4, 0,2.5,0]},
     "pose":   {"from": {"yaw": -0.25, "pitch": 0.16, "roll": 1.4508, "py": 2.5}, "to": {"yaw": 0.30, "pitch": 0.16, "roll": 1.6908, "py": 2.5}}},
    {"name": "phone-portrait-lean-outro","device": "iphone-portrait", "env": "white", "durationMs": 3200,
     "camera": {"from": [1.6,3.0,9.8, 0.3,2.7,0], "to": [2.4,3.4,9.2, 0.3,2.6,0]},
     "pose":   {"from": {"yaw": 0.34, "pitch": -0.06, "py": 2.9}, "to": {"yaw": 0.60, "pitch": -0.14, "py": 2.9}}}
  ]
}
